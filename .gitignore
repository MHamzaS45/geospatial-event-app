
# Ignore PyInstaller temporary build folders and specs
build/
*.spec
__pycache__/
.venv/

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
!*.code-workspace

